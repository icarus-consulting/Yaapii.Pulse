<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Version>3.0.0</Version>
  </PropertyGroup>
  <PropertyGroup>
    <VersionPrefix>1.0.2</VersionPrefix>
    <Authors>ICARUS Consulting GmbH</Authors>
    <Copyright>ICARUS Consulting GmbH</Copyright>
    <Description>A library for object oriented event handling.</Description>
    <RepositoryUrl>https://github.com/icarus-consulting/Yaapii.Pulse</RepositoryUrl>
    <PackageTags>yaapii, pulse</PackageTags>
    <PackageProjectUrl>https://github.com/icarus-consulting/Yaapii.Pulse</PackageProjectUrl>
    <PackageReleaseNotes>https://github.com/icarus-consulting/Yaapii.Pulse/releases</PackageReleaseNotes>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\sgKey.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>
  <ItemGroup></ItemGroup>
  <Choose>
    <When Condition="'$(Configuration)'=='Release'">
      <ItemGroup>
        <ProjectReference Include="..\..\..\Yaapii.JSON\src\Yaapii.JSON\Yaapii.JSON.csproj" />
      </ItemGroup>
    </When>
    <Otherwise>
      <ItemGroup>
        <PackageReference Include="Yaapii.JSON" Version="13.4.0" />
      </ItemGroup>
    </Otherwise>
  </Choose>
</Project>